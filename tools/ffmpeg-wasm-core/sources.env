# Pinned Source Specifications for Reproducible FFmpeg.wasm Core
# Gravipress v1.1.0 Custom Multimedia Engine

# 1. Build Toolchain
EMSDK_IMAGE=emscripten/emsdk:3.1.40
EMSDK_VERSION=3.1.40

# 2. FFmpeg Core (Security Maintenance Point Release)
FFMPEG_VERSION=5.1.10
FFMPEG_TAG=n5.1.10
FFMPEG_COMMIT=19feb712f5c1821d8a3fa1ad63c5bd2e3b9672eb
FFMPEG_URL=https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n5.1.10.tar.gz

# 3. Codec Libraries (Exact Pinned Versions & Immutable URLs)
# Video: x264 (H.264 Encoder - GPL-2.0+)
X264_COMMIT=baee400fa9ced6f5481a728138fed6e867b0ff7f
X264_URL=https://github.com/ffmpegwasm/x264.git

# Video: libvpx (VP8/VP9 Encoder/Decoder - BSD-3-Clause)
LIBVPX_VERSION=1.17.0
LIBVPX_TAG=v1.17.0
LIBVPX_COMMIT=6df3ec34557879fff673706f4a1d9fbd0f3a6f0e
LIBVPX_URL=https://github.com/webmproject/libvpx/archive/refs/tags/v1.17.0.tar.gz

# Audio: LAME (MP3 Encoder - LGPL-2.0+)
LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz

# Audio: Ogg Container (BSD-3-Clause)
LIBOGG_VERSION=1.3.5
LIBOGG_URL=https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.gz

# Audio: Vorbis Codec (BSD-3-Clause)
LIBVORBIS_VERSION=1.3.7
LIBVORBIS_URL=https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.gz

# Audio: Opus Codec (BSD-3-Clause)
LIBOPUS_VERSION=1.4
LIBOPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.4.tar.gz

# In-Tree Native Codecs (No external dependency required):
# - AAC Encoder / Decoder: Native FFmpeg (LGPL-2.1+)
# - FLAC Encoder / Decoder: Native FFmpeg (LGPL-2.1+)
# - PCM Formats (16/24/32-bit): Native FFmpeg (LGPL-2.1+)
